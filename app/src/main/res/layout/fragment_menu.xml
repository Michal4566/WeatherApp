<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialCardView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="@color/glass_white"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/glass_white_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/menu_header_content_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/menu_header_illustration" />

                <!-- gradient overlay dla czytelności tekstu -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/header_text_overlay" />

                <!-- tytuł i podtytuł nałożone na obraz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/menu_quick_actions"
                        android:textColor="@color/text_main"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.80"
                        android:text="@string/menu_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- karta grupująca przyciski -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/glass_white"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_white_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- przycisk główny wyróżniony -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefresh"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="52dp"
                        android:text="Odśwież"
                        android:textAllCaps="false"
                        android:textColor="@color/bg_start"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_cyan"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_popup_sync"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/bg_start"
                        app:rippleColor="@color/glass_white_stroke"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeLocation"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="50dp"
                        android:text="Lokalizacja"
                        android:textAllCaps="false"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/surface_glass_strong"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_mylocation"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/accent_cyan"
                        app:rippleColor="@color/accent_cyan_soft"
                        app:strokeColor="@color/glass_white_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeUnits"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="50dp"
                        android:text="Jednostki"
                        android:textAllCaps="false"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/surface_glass_strong"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_compass"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/accent_cyan"
                        app:rippleColor="@color/accent_cyan_soft"
                        app:strokeColor="@color/glass_white_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddLocation"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="50dp"
                        android:text="Dodaj"
                        android:textAllCaps="false"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/surface_glass_strong"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/accent_cyan"
                        app:rippleColor="@color/accent_cyan_soft"
                        app:strokeColor="@color/glass_white_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveLocation"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:text="Usuń"
                        android:textAllCaps="false"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/surface_glass_strong"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/accent_cyan"
                        app:rippleColor="@color/accent_cyan_soft"
                        app:strokeColor="@color/glass_white_stroke"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
