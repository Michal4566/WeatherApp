<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/glass_white"
        app:cardCornerRadius="34dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_white_stroke"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:scrollbarThumbVertical="@color/accent_cyan">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/metric_chip_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/forecast_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_main"
                    android:textSize="28sp"
                    tools:text="Warszawa" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/forecast_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/glass_white_stroke" />

                <!-- Day 1 — wyróżniony jako dziś -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/glass_item_bg"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/metric_chip_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/forecast_today_label"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDay1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            tools:text="Day 1: 2026-03-30 12:00&#10;Temp: 22°C" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWeatherIconDay1"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/icon_badge_bg"
                        android:contentDescription="@string/forecast_icon_content_description"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Day 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/glass_item_bg"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            tools:text="Day 2: 2026-03-31 12:00&#10;Temp: 23°C" />

                        <TextView
                            android:id="@+id/tvPopDay2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/metric_chip_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/temp_cold"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="💧 45%" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWeatherIconDay2"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/icon_badge_bg"
                        android:contentDescription="@string/forecast_icon_content_description"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Day 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/glass_item_bg"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            tools:text="Day 3: 2026-04-01 12:00&#10;Temp: 21°C" />

                        <TextView
                            android:id="@+id/tvPopDay3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/metric_chip_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/temp_cold"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="💧 20%" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWeatherIconDay3"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/icon_badge_bg"
                        android:contentDescription="@string/forecast_icon_content_description"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Day 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/glass_item_bg"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            tools:text="Day 4: 2026-04-02 12:00&#10;Temp: 19°C" />

                        <TextView
                            android:id="@+id/tvPopDay4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/metric_chip_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/temp_cold"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="💧 10%" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWeatherIconDay4"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/icon_badge_bg"
                        android:contentDescription="@string/forecast_icon_content_description"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Day 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/glass_item_bg"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            tools:text="Day 5: 2026-04-03 12:00&#10;Temp: 20°C" />

                        <TextView
                            android:id="@+id/tvPopDay5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/metric_chip_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/temp_cold"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="💧 5%" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWeatherIconDay5"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/icon_badge_bg"
                        android:contentDescription="@string/forecast_icon_content_description"
                        android:padding="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
